{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaudalGhost",
  "version": "0.2.0",
  "identifier": "net.parlox.caudalghost",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CaudalGhost",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": ["caudalghost"],
        "postInstallScript": "linux/deb/postinst.sh"
      }
    }
  }
}
